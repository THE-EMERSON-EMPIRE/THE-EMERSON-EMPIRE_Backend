# Build context: epdg-backend-core. Dedicated API image; operator job is separate.
FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS build
WORKDIR /app
RUN npm install --global npm@11.17.0 \
    && test "$(node --version)" = "v22.23.1" \
    && test "$(npm --version)" = "11.17.0"
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY scripts/copy-migrations.cjs ./scripts/copy-migrations.cjs
COPY src ./src
RUN npm run build

FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN npm install --global npm@11.17.0 \
    && test "$(node --version)" = "v22.23.1" \
    && test "$(npm --version)" = "11.17.0"
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
USER node
EXPOSE 8080
CMD ["node", "dist/hosted-practice/index.js"]
